{%- if section.settings.collection != blank -%}
  {%- assign featured_collection = collections[section.settings.collection] -%}
{%- else -%}
  {%- assign featured_collection = collections['shop-rings'] -%}
{%- endif -%}

{%- if section.settings.bg_image != blank -%}
  {%- assign _fc_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- endif -%}
{%- assign _min_h = section.settings.section_min_height -%}
{%- assign _align = section.settings.text_align -%}
{%- assign _mw    = section.settings.content_max_width -%}
{%- assign _pos   = section.settings.content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
<div {% if section.settings.bg_image != blank %}style="background-image:url('{{ _fc_bg }}');background-size:cover;background-position:center;position:relative;{% if _min_h > 0 %}min-height:{{ _min_h }}vh;{% endif %}"{% elsif _min_h > 0 %}style="min-height:{{ _min_h }}vh;"{% endif %}>
  {%- if section.settings.bg_image != blank and section.settings.bg_overlay > 0 -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.bg_overlay | divided_by: 100.0 }});pointer-events:none;" aria-hidden="true"></div>
  {%- endif -%}
  <div style="position:relative;">
<!-- ── MARQUEE TICKER ──────────────────────────────────── -->
{%- assign ticker_1 = section.settings.ticker_1 | default: 'RECLAIMED SKATEBOARDS' -%}
{%- assign ticker_2 = section.settings.ticker_2 | default: 'HANDCRAFTED IN TAMPA' -%}
{%- assign ticker_3 = section.settings.ticker_3 | default: 'SMALL BATCH' -%}
{%- assign ticker_4 = section.settings.ticker_4 | default: '1 OF 1' -%}
{%- assign ticker_5 = section.settings.ticker_5 | default: 'COASTAL FLORIDA' -%}
{%- assign ticker_6 = section.settings.ticker_6 | default: 'BEESWAX FINISH' -%}
<div class="drop-ticker" aria-hidden="true">
  <div class="drop-ticker-track">
    {%- for i in (1..4) -%}
      <span>{{ ticker_1 }}</span><span class="drop-ticker-sep">·</span>
      <span>{{ ticker_2 }}</span><span class="drop-ticker-sep">·</span>
      <span>{{ ticker_3 }}</span><span class="drop-ticker-sep">·</span>
      <span>{{ ticker_4 }}</span><span class="drop-ticker-sep">·</span>
      <span>{{ ticker_5 }}</span><span class="drop-ticker-sep">·</span>
      <span>{{ ticker_6 }}</span><span class="drop-ticker-sep">·</span>
    {%- endfor -%}
  </div>
</div>

<!-- ── DROP SECTION ───────────────────────────────────── -->
<section class="drop-section" id="products" style="padding-top:{{ section.settings.padding_top }}rem; padding-bottom:{{ section.settings.padding_bottom }}rem;">
  <div class="drop-header" style="max-width:{{ _mw }}px;margin:{{ _cmarg }};text-align:{{ _align }};">
    <div class="drop-header-left">
      <span class="eyebrow" style="color:var(--teal);">{{ section.settings.eyebrow }}</span>
      <h2 class="drop-heading" style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
    </div>
    <a href="{{ section.settings.view_all_url | default: '/collections/shop-rings' }}" class="drop-view-all">
      {{ section.settings.view_all_text }} &rarr;
    </a>
  </div>

  {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
    <div class="drop-grid">
      {%- for product in featured_collection.products limit: section.settings.product_limit -%}
        <a href="{{ product.url }}" class="drop-card">
          <div class="drop-card-img-wrap">
            {%- if product.featured_image -%}
              {%- assign card_alt = product.featured_image.alt | default: product.title -%}
              {%- unless card_alt contains 'Bayshore' -%}
                {%- assign card_alt = card_alt | append: ' — Recycled Skateboard Ring by Bayshore Rings' -%}
              {%- endunless -%}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ card_alt | escape }}" width="800" height="800" loading="lazy" class="drop-card-img">
            {%- else -%}
              {%- render 'ring-placeholder' -%}
            {%- endif -%}
            {%- if product.available == false -%}
              <span class="drop-card-badge drop-card-badge--sold">Sold Out</span>
            {%- elsif product.tags contains 'Limited' or product.tags contains 'limited' -%}
              <span class="drop-card-badge drop-card-badge--limited">Limited</span>
            {%- elsif product.tags contains 'New' or product.tags contains 'new' -%}
              <span class="drop-card-badge drop-card-badge--new">New</span>
            {%- endif -%}
          </div>
          <div class="drop-card-info">
            <div class="drop-card-name" style="font-size:{{ section.settings.body_size }}px;">{{ product.title }}</div>
            <div class="drop-card-price">
              {%- if product.price_varies -%}From {{ product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
    <div class="drop-footer">
      <a href="{{ section.settings.view_all_url | default: '/collections/shop-rings' }}" class="btn btn-gold btn-hero-primary">{{ section.settings.view_all_text }}</a>
    </div>
  {%- else -%}
    <p class="products-empty">Create a collection called <strong>Shop Rings</strong> and add products to see them here.</p>
  {%- endif -%}
</section>
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "header", "content": "Marquee Ticker" },
    { "type": "text", "id": "ticker_1", "label": "Ticker item 1", "default": "RECLAIMED SKATEBOARDS" },
    { "type": "text", "id": "ticker_2", "label": "Ticker item 2", "default": "HANDCRAFTED IN TAMPA" },
    { "type": "text", "id": "ticker_3", "label": "Ticker item 3", "default": "SMALL BATCH" },
    { "type": "text", "id": "ticker_4", "label": "Ticker item 4", "default": "1 OF 1" },
    { "type": "text", "id": "ticker_5", "label": "Ticker item 5", "default": "COASTAL FLORIDA" },
    { "type": "text", "id": "ticker_6", "label": "Ticker item 6", "default": "BEESWAX FINISH" },
    { "type": "header", "content": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Current Drop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Max products", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "view_all_text", "label": "View All text", "default": "Shop All Rings" },
    { "type": "url", "id": "view_all_url", "label": "View All link" },
    { "type": "header", "content": "Section Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay darkness (%)", "min": 0, "max": 80, "step": 10, "default": 0 },
    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (rem)", "min": 0, "max": 16, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (rem)", "min": 0, "max": 16, "step": 1, "default": 4 },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "left" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 1200 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Section height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 0 }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
