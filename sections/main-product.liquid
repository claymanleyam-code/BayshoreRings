{%- if section.settings.bg_image != blank -%}
  {%- assign _prod_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- endif -%}
{%- assign _min_h = settings.product_section_min_height -%}
{%- assign _align = settings.product_text_align -%}
{%- assign _mw    = settings.product_content_max_width -%}
{%- assign _pos   = settings.product_content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
{%- assign _use_block_imgs = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'product_image' and block.settings.image != blank -%}
    {%- assign _use_block_imgs = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if _use_block_imgs -%}
  {%- assign _slide_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product_image' and block.settings.image != blank -%}
      {%- assign _slide_count = _slide_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- assign _slide_count = product.images.size -%}
  {%- if _slide_count == 0 -%}{%- assign _slide_count = 1 -%}{%- endif -%}
{%- endif -%}
<article class="page-wrap" itemscope itemtype="https://schema.org/Product" style="{% if section.settings.bg_image != blank %}background-image:url('{{ _prod_bg }}');background-size:cover;background-position:center;position:relative;{% endif %}{% if _min_h > 0 %}min-height:{{ _min_h }}vh;display:flex;flex-direction:column;justify-content:center;{% endif %}">
  {%- if section.settings.bg_image != blank and section.settings.bg_overlay > 0 -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.bg_overlay | divided_by: 100.0 }});pointer-events:none;" aria-hidden="true"></div>
  {%- endif -%}
  <meta itemprop="brand" content="Bayshore Rings">
  <meta itemprop="category" content="Eco-Friendly Jewelry">

  <div class="product-layout" style="max-width:{{ _mw }}px;margin:{{ _cmarg }};">

    <div class="product-image product-carousel" id="pcarousel-{{ section.id }}">
      <div class="carousel-track">
        {%- if _use_block_imgs -%}
          {%- assign _si = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_image' and block.settings.image != blank -%}
              {%- assign _img = block.settings.image -%}
              {%- assign _alt = _img.alt | default: product.title -%}
              <div class="carousel-slide{% if _si == 0 %} active{% endif %}" {{ block.shopify_attributes }}>
                <img src="{{ _img | image_url: width: 800 }}" alt="{{ _alt | escape }}" width="800" height="800" loading="{% if _si == 0 %}eager{% else %}lazy{% endif %}"{% if _si == 0 %} itemprop="image"{% endif %}>
                {%- if block.settings.caption != blank -%}
                  <p class="carousel-caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
              {%- assign _si = _si | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif product.images.size > 0 -%}
          {%- for img in product.images -%}
            {%- assign _alt = img.alt | default: product.title -%}
            {%- unless _alt contains 'Bayshore' -%}
              {%- assign _alt = _alt | append: ' — Recycled Skateboard Ring by Bayshore Rings' -%}
            {%- endunless -%}
            <div class="carousel-slide{% if forloop.first %} active{% endif %}">
              <img src="{{ img | image_url: width: 800 }}" alt="{{ _alt | escape }}" width="800" height="800" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} itemprop="image"{% endif %}>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="carousel-slide active">
            {% render 'ring-placeholder' %}
          </div>
        {%- endif -%}
      </div>
      {%- if _slide_count > 1 -%}
        <button class="carousel-btn carousel-prev" aria-label="Previous image">&#8249;</button>
        <button class="carousel-btn carousel-next" aria-label="Next image">&#8250;</button>
        <div class="carousel-dots" aria-hidden="true">
          {%- for i in (1.._slide_count) -%}
            <button class="carousel-dot{% if forloop.first %} active{% endif %}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info" style="text-align:{{ _align }};">
      {%- assign _has_badges = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' and block.settings.label != blank -%}{%- assign _has_badges = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- if _has_badges -%}
        <div class="product-badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' and block.settings.label != blank -%}
              <span class="product-badge product-badge--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if product.type != blank -%}
        <p class="product-type" itemprop="category" style="font-size:{{ settings.product_body_size }}px;">{{ product.type }}</p>
      {%- endif -%}

      <h1 itemprop="name" style="font-size:{{ settings.product_heading_size }}px;{% if settings.product_heading_color != blank %}color:{{ settings.product_heading_color }};{% endif %}">{{ product.title }}</h1>
      <div class="product-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <span itemprop="price" content="{{ product.price | money_without_currency | remove: ',' }}">{{ product.price | money }}</span>
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <link itemprop="availability" href="{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}">
      </div>

      {%- if product.description != blank -%}
        <div class="product-desc" itemprop="description" style="font-size:{{ settings.product_body_size }}px;{% if settings.product_body_color != blank %}color:{{ settings.product_body_color }};{% endif %}">{{ product.description }}</div>
      {%- endif -%}

      {%- form 'product', product, class: 'product-form' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option">
              <div class="product-option-header">
                <label class="product-option-label" for="Option-{{ forloop.index }}">{{ option.name }}</label>
                {%- if option.name == 'Size' or option.name == 'Ring Size' -%}
                  <a href="/pages/ring-sizing" class="size-guide-link" target="_blank">
                    Size Guide
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                {%- endif -%}
              </div>
              <select id="Option-{{ forloop.index }}" name="id" class="product-select">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} — Sold Out{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endunless -%}
        {%- if product.available -%}
          <button type="submit" class="product-submit">Add to Cart</button>
        {%- else -%}
          <button type="button" class="product-submit so-trigger" data-product="{{ product.title | escape }}">Sold Out</button>
        {%- endif -%}
      {%- endform -%}

      <div class="product-meta">
        {%- if section.settings.meta_1 != blank -%}
          <span class="product-meta-item" style="font-size:{{ settings.product_body_size | minus: 2 }}px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {{ section.settings.meta_1 }}
          </span>
        {%- endif -%}
        {%- if section.settings.meta_2 != blank -%}
          <span class="product-meta-item" style="font-size:{{ settings.product_body_size | minus: 2 }}px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 12 20 22 4 22"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            {{ section.settings.meta_2 }}
          </span>
        {%- endif -%}
        {%- if section.settings.meta_3 != blank -%}
          <span class="product-meta-item" style="font-size:{{ settings.product_body_size | minus: 2 }}px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {{ section.settings.meta_3 }}
          </span>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'rich_text' -%}
          <div class="product-rich-text" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="product-rich-heading" style="font-size:{{ settings.product_body_size | plus: 2 }}px;{% if settings.product_heading_color != blank %}color:{{ settings.product_heading_color }};{% endif %}">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.content != blank -%}
              <div class="product-rich-body" style="font-size:{{ settings.product_body_size }}px;{% if settings.product_body_color != blank %}color:{{ settings.product_body_color }};{% endif %}">{{ block.settings.content }}</div>
            {%- endif -%}
          </div>
        {%- elsif block.type == 'divider' -%}
          <hr class="product-divider" {{ block.shopify_attributes }}>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

  <!-- SEO Feature Callouts -->
  <section class="product-features" aria-label="{{ section.settings.features_heading | default: 'Why Bayshore Rings' }}">
    <h2 class="product-features-heading" style="font-size:{{ settings.product_heading_size | times: 0.65 | round }}px;">{{ section.settings.features_heading | default: 'Why Bayshore Rings Skateboard Rings?' }}</h2>
    <div class="product-features-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="product-feature-item" {{ block.shopify_attributes }}>
            <h3 style="font-size:{{ settings.product_body_size | plus: 2 }}px;">{{ block.settings.title }}</h3>
            <p style="font-size:{{ settings.product_body_size }}px;">{{ block.settings.body }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

</article>

<div id="so-modal" class="so-overlay" aria-hidden="true">
  <div class="so-dialog" role="dialog" aria-modal="true" aria-labelledby="so-heading">
    <button class="so-close" aria-label="Close">&times;</button>
    <h2 class="so-heading" id="so-heading">Ring Inquiry</h2>
    <p class="so-sub">This ring is currently sold out. Leave your info and we'll reach out when it's back.</p>
    <form id="so-form" class="so-form">
      <input type="hidden" id="so-product-name" name="product">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="so-field">
          <label for="so-first-name">First Name</label>
          <input type="text" id="so-first-name" name="first_name" placeholder="First" autocomplete="given-name" required>
        </div>
        <div class="so-field">
          <label for="so-last-name">Last Name</label>
          <input type="text" id="so-last-name" name="last_name" placeholder="Last" autocomplete="family-name" required>
        </div>
      </div>
      <div class="so-field">
        <label for="so-email">Email</label>
        <input type="email" id="so-email" name="email" placeholder="your@email.com" autocomplete="email" required>
      </div>
      <div class="so-field">
        <label for="so-phone">Phone</label>
        <input type="tel" id="so-phone" name="phone" placeholder="(555) 000-0000" autocomplete="tel">
      </div>
      <div class="so-field">
        <label for="so-state">State</label>
        <input type="text" id="so-state" name="state" placeholder="e.g. FL" autocomplete="address-level1">
      </div>
      <div class="so-field">
        <label for="so-size">Ring Size</label>
        <input type="text" id="so-size" name="ring_size" placeholder="e.g. 8, 8.5" required>
      </div>
      <button type="submit" class="so-submit">Send Inquiry</button>
    </form>
    <div id="so-success" class="so-success" hidden>
      <p>Thanks! We'll be in touch soon.</p>
    </div>
  </div>
</div>

<script>
(function () {
  var SHEET_URL = 'https://script.google.com/macros/s/AKfycbwWy1bhlS8K4lwCUqbv5goAB9NNYAAl9Y3yNHxz20KYBYOtPwIhmCK7CMxRwMyjGMJd/exec';
  var modal   = document.getElementById('so-modal');
  var form    = document.getElementById('so-form');
  var success = document.getElementById('so-success');

  var STATES = ['AL','AK','AZ','AR','CA','CO','CT','DE','FL','GA','HI','ID','IL','IN','IA',
                'KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ',
                'NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT',
                'VA','WA','WV','WI','WY'];

  function toTitleCase(str) {
    return str.trim().replace(/\S+/g, function (w) {
      return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
    });
  }

  function normalizePhone(str) {
    return str.replace(/[\s()\-]/g, '');
  }

  function setError(input, msg) {
    clearError(input);
    var err = document.createElement('span');
    err.className = 'so-error';
    err.textContent = msg;
    input.closest('.so-field').appendChild(err);
    input.setAttribute('aria-invalid', 'true');
  }

  function clearError(input) {
    var field = input.closest('.so-field');
    var err = field.querySelector('.so-error');
    if (err) err.remove();
    input.removeAttribute('aria-invalid');
  }

  function validate(data) {
    var ok = true;
    var fn = form.querySelector('#so-first-name');
    var ln = form.querySelector('#so-last-name');
    var em = form.querySelector('#so-email');
    var ph = form.querySelector('#so-phone');
    var st = form.querySelector('#so-state');
    var sz = form.querySelector('#so-size');

    if (!fn.value.trim() || !/^[A-Za-z\s\-']+$/.test(fn.value.trim())) {
      setError(fn, 'Letters only — no numbers or special characters.'); ok = false;
    } else { clearError(fn); }

    if (!ln.value.trim() || !/^[A-Za-z\s\-']+$/.test(ln.value.trim())) {
      setError(ln, 'Letters only — no numbers or special characters.'); ok = false;
    } else { clearError(ln); }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em.value.trim())) {
      setError(em, 'Enter a valid email address.'); ok = false;
    } else { clearError(em); }

    if (ph.value.trim()) {
      var phoneClean = ph.value.trim();
      if (!/^[\d\s()\-]+$/.test(phoneClean) || !/^\d{10}$/.test(phoneClean.replace(/[\s()\-]/g, ''))) {
        setError(ph, 'Use (555) 000-0000, 555-000-0000, or 10 digits.'); ok = false;
      } else { clearError(ph); }
    } else { clearError(ph); }

    if (st.value.trim()) {
      if (!STATES.includes(st.value.trim().toUpperCase())) {
        setError(st, 'Enter a valid 2-letter US state abbreviation.'); ok = false;
      } else { clearError(st); }
    } else { clearError(st); }

    if (!sz.value.trim() || !/^\d+(\.\d+)?$/.test(sz.value.trim())) {
      setError(sz, 'Enter a number (e.g. 8 or 8.5).'); ok = false;
    } else { clearError(sz); }

    return ok;
  }

  function openModal(productName) {
    document.getElementById('so-product-name').value = productName || '';
    modal.setAttribute('aria-hidden', 'false');
    document.getElementById('so-first-name').focus();
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    form.reset();
    form.hidden = false;
    form.querySelector('.so-submit').hidden = false;
    success.hidden = true;
    form.querySelectorAll('input').forEach(function (i) { clearError(i); });
  }

  form.querySelectorAll('input').forEach(function (input) {
    input.addEventListener('input', function () { if (this.getAttribute('aria-invalid')) clearError(this); });
  });

  document.querySelectorAll('.so-trigger').forEach(function (btn) {
    btn.addEventListener('click', function () { openModal(this.dataset.product); });
  });

  modal.querySelector('.so-close').addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') closeModal();
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var btn = form.querySelector('.so-submit');
    if (!validate()) return;
    btn.hidden = true;

    var data = new FormData(form);
    var rawPhone = (data.get('phone') || '').trim();
    var rawState = (data.get('state') || '').trim();

    var params = new URLSearchParams({
      submitted_at: new Date().toISOString(),
      product:    data.get('product') || '',
      first_name: toTitleCase(data.get('first_name') || ''),
      last_name:  toTitleCase(data.get('last_name') || ''),
      email:      (data.get('email') || '').trim(),
      phone:      rawPhone ? normalizePhone(rawPhone) : '',
      state:      rawState ? rawState.toUpperCase() : '',
      ring_size:  (data.get('ring_size') || '').trim()
    });

    fetch(SHEET_URL + '?' + params.toString(), { mode: 'no-cors' })
    .then(function () {
      form.hidden = true;
      success.hidden = false;
    })
    .catch(function () {
      btn.hidden = false;
      alert('Something went wrong. Please email us directly.');
    });
  });
})();
</script>

<script>
(function(){
  var el = document.getElementById('pcarousel-{{ section.id }}');
  if (!el) return;
  var slides = el.querySelectorAll('.carousel-slide');
  var dots   = el.querySelectorAll('.carousel-dot');
  var prevBtn = el.querySelector('.carousel-prev');
  var nextBtn = el.querySelector('.carousel-next');
  if (slides.length < 2) return;
  var cur = 0;
  function go(n) {
    slides[cur].classList.remove('active');
    if (dots[cur]) dots[cur].classList.remove('active');
    cur = (n + slides.length) % slides.length;
    slides[cur].classList.add('active');
    if (dots[cur]) dots[cur].classList.add('active');
  }
  if (prevBtn) prevBtn.addEventListener('click', function(){ go(cur - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function(){ go(cur + 1); });
  dots.forEach(function(d, i){ d.addEventListener('click', function(){ go(i); }); });
  var tx = 0;
  el.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
  el.addEventListener('touchend', function(e){
    var dx = tx - e.changedTouches[0].clientX;
    if (Math.abs(dx) > 40) go(dx > 0 ? cur + 1 : cur - 1);
  }, {passive:true});
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Page Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay darkness (%)", "min": 0, "max": 80, "step": 10, "default": 0 },
    { "type": "header", "content": "Product Meta Badges" },
    { "type": "text", "id": "meta_1", "label": "Badge 1 (shipping)", "default": "Free shipping on all domestic orders" },
    { "type": "text", "id": "meta_2", "label": "Badge 2 (material)", "default": "Handcrafted from recycled skateboard wood" },
    { "type": "text", "id": "meta_3", "label": "Badge 3 (lead time)", "default": "Made to order — ships in 5–7 business days" },
    { "type": "header", "content": "Feature Callouts" },
    { "type": "text", "id": "features_heading", "label": "Features section heading", "default": "Why Bayshore Rings Skateboard Rings?" },
    { "type": "paragraph", "content": "Typography, colors, layout, and section height are controlled globally under Theme Settings → Product Listings." }
  ],
  "blocks": [
    {
      "type": "product_image",
      "name": "Image",
      "limit": 10,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" }
      ]
    },
    {
      "type": "badge",
      "name": "Badge / Label",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Badge text", "default": "New" },
        { "type": "select", "id": "style", "label": "Style", "options": [{"value":"default","label":"Default (dark)"},{"value":"highlight","label":"Highlight (gold)"},{"value":"sale","label":"Sale (red)"}], "default": "default" }
      ]
    },
    {
      "type": "rich_text",
      "name": "Text Block",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "limit": 5,
      "settings": []
    },
    {
      "type": "feature",
      "name": "Feature Callout",
      "settings": [
        { "type": "text", "id": "title", "label": "Feature title", "default": "Feature Title" },
        { "type": "textarea", "id": "body", "label": "Feature description", "default": "Description of this feature." }
      ]
    }
  ],
  "presets": [{
    "name": "Product",
    "blocks": [
      { "type": "feature", "settings": { "title": "Waterproof Wooden Jewelry", "body": "Sealed with a food-grade beeswax finish so your wooden jewelry holds up to daily wear, water, and the elements — without cracking or warping." } },
      { "type": "feature", "settings": { "title": "Real Recycled Jewelry", "body": "Every skateboard ring is shaped from a retired deck. The natural maple layers make each piece of recycled jewelry unique — no two colorways are the same." } },
      { "type": "feature", "settings": { "title": "Tampa-Made Recycled Jewelry", "body": "Crafted by hand in Tampa, FL. Our recycled jewelry is made in small batches — zero mass production, zero virgin materials, zero shortcuts." } },
      { "type": "feature", "settings": { "title": "The Only Skateboard Ring Like It", "body": "A standout choice for skaters, surfers, and anyone who wants Tampa jewelry that tells a real story — an alternative wedding band with actual skate culture roots." } }
    ]
  }]
}
{% endschema %}
