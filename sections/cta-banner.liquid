{%- if section.settings.bg_image != blank -%}
  {%- assign _cta_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- endif -%}
{%- assign _min_h = section.settings.section_min_height -%}
{%- assign _align = section.settings.text_align -%}
{%- assign _mw    = section.settings.content_max_width -%}
{%- assign _pos   = section.settings.content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
<section class="cta-section" style="padding-top:{{ section.settings.padding_top }}rem; padding-bottom:{{ section.settings.padding_bottom }}rem;{% if _min_h > 0 %}min-height:{{ _min_h }}vh;display:flex;flex-direction:column;justify-content:center;{% endif %}{% if section.settings.bg_image != blank %} background-image:url('{{ _cta_bg }}');background-size:cover;background-position:center;position:relative;{% endif %}">
  {%- if section.settings.bg_image != blank and section.settings.bg_overlay > 0 -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.bg_overlay | divided_by: 100.0 }});pointer-events:none;" aria-hidden="true"></div>
  {%- endif -%}
  <div class="cta-content reveal" style="position:relative;max-width:{{ _mw }}px;margin:{{ _cmarg }};text-align:{{ _align }};">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn-gold" style="font-size:0.85rem; padding:1rem 2.5rem;">
      {{ section.settings.btn_text }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Get Yours" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear the Board. Keep the Story." },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "Shop the Collection" },
    { "type": "url", "id": "btn_url", "label": "Button link" },
    { "type": "header", "content": "Section Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay darkness (%)", "min": 0, "max": 80, "step": 10, "default": 0 },
    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (rem)", "min": 0, "max": 16, "step": 1, "default": 5 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (rem)", "min": 0, "max": 16, "step": 1, "default": 5 },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 700 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Section height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 100 }
  ],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}
