{%- if section.settings.bg_image != blank -%}
  {%- assign _siz_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- endif -%}
{%- assign _min_h = section.settings.section_min_height -%}
{%- assign _align = section.settings.text_align -%}
{%- assign _mw    = section.settings.content_max_width -%}
{%- assign _pos   = section.settings.content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
<div class="page-wrap" style="{% if section.settings.bg_image != blank %}background-image:url('{{ _siz_bg }}');background-size:cover;background-position:center;position:relative;{% endif %}{% if _min_h > 0 %}min-height:{{ _min_h }}vh;display:flex;flex-direction:column;justify-content:center;{% endif %}">
  {%- if section.settings.bg_image != blank and section.settings.bg_overlay > 0 -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.bg_overlay | divided_by: 100.0 }});pointer-events:none;" aria-hidden="true"></div>
  {%- endif -%}
  <div class="collection-header reveal" style="max-width:{{ _mw }}px;margin:{{ _cmarg }};text-align:{{ _align }};">
    <span class="eyebrow section-label">{{ section.settings.eyebrow | default: 'Ring Sizing' }}</span>
    <h1 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading | default: 'Find Your Size' }}</h1>
    <div class="gold-bar"></div>
    <p class="section-body" style="font-size:{{ section.settings.body_size }}px;">{{ section.settings.intro | default: "Our rings are sized to standard US ring sizes. If you're between sizes, we recommend sizing up." }}</p>
  </div>

  <div style="max-width:{{ _mw }}px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:2.5rem;">
      <div class="sizing-tip">
        <h4 style="font-size:{{ section.settings.body_size | plus: 2 }}px;">{{ section.settings.method_1_title | default: 'String Method' }}</h4>
        <p style="font-size:{{ section.settings.body_size }}px;">{{ section.settings.method_1_body | default: "Wrap a thin strip of paper or string around the base of your finger. Mark where it overlaps, then measure the length in millimeters. That's your finger circumference — use the table below." }}</p>
      </div>
      <div class="sizing-tip">
        <h4 style="font-size:{{ section.settings.body_size | plus: 2 }}px;">{{ section.settings.method_2_title | default: 'Existing Ring Method' }}</h4>
        <p style="font-size:{{ section.settings.body_size }}px;">{{ section.settings.method_2_body | default: 'Place a ring you already own on a ruler and measure the inside diameter in millimeters. Match that measurement to the table below.' }}</p>
      </div>
    </div>

    <div class="sizing-table-wrap reveal">
      <table class="sizing-table">
        <thead>
          <tr><th>US Size</th><th>Inner Diameter (mm)</th><th>Circumference (mm)</th><th>Common Fit</th></tr>
        </thead>
        <tbody>
          <tr><td>5</td><td>15.7</td><td>49.3</td><td>Small / Pinky</td></tr>
          <tr><td>6</td><td>16.5</td><td>51.8</td><td>Slim finger</td></tr>
          <tr><td>7</td><td>17.3</td><td>54.4</td><td>Average women's</td></tr>
          <tr class="sizing-highlight"><td>8</td><td>18.2</td><td>57.2</td><td>Most popular</td></tr>
          <tr class="sizing-highlight"><td>9</td><td>19.0</td><td>59.7</td><td>Most popular</td></tr>
          <tr><td>10</td><td>19.8</td><td>62.1</td><td>Average men's</td></tr>
          <tr><td>11</td><td>20.6</td><td>64.6</td><td>Average men's</td></tr>
          <tr><td>12</td><td>21.4</td><td>67.2</td><td>Larger finger</td></tr>
          <tr><td>13</td><td>22.2</td><td>69.7</td><td>Larger finger</td></tr>
          <tr><td>14</td><td>23.0</td><td>72.3</td><td>Wide / knuckle fit</td></tr>
        </tbody>
      </table>
    </div>

    <div class="sizing-tip reveal" style="margin-top:2rem;">
      <h4 style="font-size:{{ section.settings.body_size | plus: 2 }}px;">{{ section.settings.tips_title | default: 'Pro Tips' }}</h4>
      <p style="font-size:{{ section.settings.body_size }}px;">{{ section.settings.tips_body | default: 'Fingers swell slightly in heat and after physical activity — measure at the end of the day for the most accurate size. Wider bands (8mm+) typically fit tighter than thin bands, so consider sizing up half a size for our thicker styles.' }}</p>
    </div>

    <div style="text-align:{{ _align }};margin-top:3rem;" class="reveal">
      <p style="color:var(--muted);font-size:{{ section.settings.body_size }}px;margin-bottom:1.25rem;">{{ section.settings.cta_text | default: "Still not sure? We're happy to help." }}</p>
      <a href="{{ section.settings.btn_1_url | default: '/pages/contact' }}" class="btn btn-navy" style="margin-right:0.75rem;">{{ section.settings.btn_1_label | default: 'Contact Us' }}</a>
      <a href="{{ section.settings.btn_2_url | default: '/collections/all' }}" class="btn btn-gold">{{ section.settings.btn_2_label | default: 'Shop Rings' }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ring Sizing",
  "settings": [
    { "type": "header", "content": "Page Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay darkness (%)", "min": 0, "max": 80, "step": 10, "default": 0 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Ring Sizing" },
    { "type": "text", "id": "heading", "label": "Page heading", "default": "Find Your Size" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Our rings are sized to standard US ring sizes. If you're between sizes, we recommend sizing up." },
    { "type": "header", "content": "Measuring Methods" },
    { "type": "text", "id": "method_1_title", "label": "Method 1 title", "default": "String Method" },
    { "type": "textarea", "id": "method_1_body", "label": "Method 1 description", "default": "Wrap a thin strip of paper or string around the base of your finger. Mark where it overlaps, then measure the length in millimeters. That's your finger circumference — use the table below." },
    { "type": "text", "id": "method_2_title", "label": "Method 2 title", "default": "Existing Ring Method" },
    { "type": "textarea", "id": "method_2_body", "label": "Method 2 description", "default": "Place a ring you already own on a ruler and measure the inside diameter in millimeters. Match that measurement to the table below." },
    { "type": "header", "content": "Pro Tips" },
    { "type": "text", "id": "tips_title", "label": "Tips heading", "default": "Pro Tips" },
    { "type": "textarea", "id": "tips_body", "label": "Tips text", "default": "Fingers swell slightly in heat and after physical activity — measure at the end of the day for the most accurate size. Wider bands (8mm+) typically fit tighter than thin bands, so consider sizing up half a size for our thicker styles." },
    { "type": "header", "content": "Bottom CTA" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Still not sure? We're happy to help." },
    { "type": "text", "id": "btn_1_label", "label": "Button 1 label", "default": "Contact Us" },
    { "type": "url", "id": "btn_1_url", "label": "Button 1 link" },
    { "type": "text", "id": "btn_2_label", "label": "Button 2 label", "default": "Shop Rings" },
    { "type": "url", "id": "btn_2_url", "label": "Button 2 link" },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 700 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Section height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 100 }
  ],
  "presets": [{ "name": "Ring Sizing" }]
}
{% endschema %}
