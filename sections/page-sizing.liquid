<div class="page-wrap">
  <div class="collection-header reveal" style="max-width:680px;">
    <span class="eyebrow section-label">{{ section.settings.eyebrow | default: 'Ring Sizing' }}</span>
    <h1>{{ section.settings.heading | default: 'Find Your Size' }}</h1>
    <div class="gold-bar"></div>
    <p class="section-body">{{ section.settings.intro | default: 'Our rings are sized to standard US ring sizes. If you\'re between sizes, we recommend sizing up.' }}</p>
  </div>

  <div style="max-width:760px;margin:0 auto;">

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:2.5rem;">
      <div class="sizing-tip">
        <h4>{{ section.settings.method_1_title | default: 'String Method' }}</h4>
        <p>{{ section.settings.method_1_body | default: 'Wrap a thin strip of paper or string around the base of your finger. Mark where it overlaps, then measure the length in millimeters. That\'s your finger circumference — use the table below.' }}</p>
      </div>
      <div class="sizing-tip">
        <h4>{{ section.settings.method_2_title | default: 'Existing Ring Method' }}</h4>
        <p>{{ section.settings.method_2_body | default: 'Place a ring you already own on a ruler and measure the inside diameter in millimeters. Match that measurement to the table below.' }}</p>
      </div>
    </div>

    <div class="sizing-table-wrap reveal">
      <table class="sizing-table">
        <thead>
          <tr>
            <th>US Size</th>
            <th>Inner Diameter (mm)</th>
            <th>Circumference (mm)</th>
            <th>Common Fit</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>5</td><td>15.7</td><td>49.3</td><td>Small / Pinky</td></tr>
          <tr><td>6</td><td>16.5</td><td>51.8</td><td>Slim finger</td></tr>
          <tr><td>7</td><td>17.3</td><td>54.4</td><td>Average women's</td></tr>
          <tr class="sizing-highlight"><td>8</td><td>18.2</td><td>57.2</td><td>Most popular</td></tr>
          <tr class="sizing-highlight"><td>9</td><td>19.0</td><td>59.7</td><td>Most popular</td></tr>
          <tr><td>10</td><td>19.8</td><td>62.1</td><td>Average men's</td></tr>
          <tr><td>11</td><td>20.6</td><td>64.6</td><td>Average men's</td></tr>
          <tr><td>12</td><td>21.4</td><td>67.2</td><td>Larger finger</td></tr>
          <tr><td>13</td><td>22.2</td><td>69.7</td><td>Larger finger</td></tr>
          <tr><td>14</td><td>23.0</td><td>72.3</td><td>Wide / knuckle fit</td></tr>
        </tbody>
      </table>
    </div>

    <div class="sizing-tip reveal" style="margin-top:2rem;">
      <h4>{{ section.settings.tips_title | default: 'Pro Tips' }}</h4>
      <p>{{ section.settings.tips_body | default: 'Fingers swell slightly in heat and after physical activity — measure at the end of the day for the most accurate size. Wider bands (8mm+) typically fit tighter than thin bands, so consider sizing up half a size for our thicker styles.' }}</p>
    </div>

    <div style="text-align:center;margin-top:3rem;" class="reveal">
      <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1.25rem;">{{ section.settings.cta_text | default: 'Still not sure? We\'re happy to help.' }}</p>
      <a href="{{ section.settings.btn_1_url | default: '/pages/contact' }}" class="btn btn-navy" style="margin-right:0.75rem;">{{ section.settings.btn_1_label | default: 'Contact Us' }}</a>
      <a href="{{ section.settings.btn_2_url | default: '/collections/all' }}" class="btn btn-gold">{{ section.settings.btn_2_label | default: 'Shop Rings' }}</a>
    </div>

  </div>
</div>

