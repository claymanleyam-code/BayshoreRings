<!-- ═══════════════════════════════════════════════════
     BAYSHORE RINGS — About Us Page
     ═══════════════════════════════════════════════════ -->

<!-- ── 3. ORIGIN STORY ───────────────────────────────────── -->
<section class="section about-origin">
  <div class="container">
    <div class="about-origin-text">
      <span class="eyebrow reveal d1" style="color:#111;">{{ section.settings.origin_eyebrow | default: 'Where It Started' }}</span>
      <h2 class="about-origin-heading reveal d2">{{ section.settings.origin_heading | default: 'A Board, a Saw, and a Good Idea' }}</h2>
      <p class="section-body reveal d3">{{ section.settings.origin_body_1 | default: 'It started in a garage. A skateboard deck — maple wood dense enough to absorb years of impact — went onto the bandsaw. The cross-section stopped everything. Seven layers of hard maple with teal, red, and raw wood stacked like a tiny landscape. A ring was the obvious next move.' }}</p>
      <p class="section-body reveal d4" style="margin-top:1.25rem;">{{ section.settings.origin_body_2 | default: "Bayshore Rings grew from that one cut. Small operation, made by hand, built on a commitment to reclaimed materials and zero synthetic finishes. The goal was never to make precious jewelry. It was to make something worth keeping — jewelry that outlasts trends and throwaway culture." }}</p>
    </div>
  </div>
</section>

<!-- ── 3b. ORIGIN IMAGE ───────────────────────────────────── -->
<div class="about-origin-image-block">
  <img
    src="{{ 'about-decks.jpg' | asset_url }}"
    alt="Bayshore Rings workshop tools and setup"
    loading="lazy" width="600" height="400">
</div>

<!-- ── 8. FOUNDER ────────────────────────────────────────── -->
<section class="section about-founder">
  <div class="container">
    <div class="about-founder-grid">
      <div class="about-founder-img reveal d1">
        {%- if section.settings.founder_image != blank -%}
          {{ section.settings.founder_image | image_url: width: 600 | image_tag:
            class: 'about-founder-photo',
            alt: section.settings.founder_name | default: 'Founder',
            loading: 'lazy'
          }}
        {%- else -%}
          <img
            src="{{ 'about-first-workshop.jpg' | asset_url }}"
            alt="Bayshore Rings founder at work in the workshop"
            class="about-founder-photo"
            loading="lazy" width="600" height="800">
        {%- endif -%}
      </div>
      <div class="about-founder-text reveal d2">
        <span class="eyebrow">{{ section.settings.founder_eyebrow | default: 'The Maker' }}</span>
        <h2 class="about-founder-name">{{ section.settings.founder_name | default: 'Clay' }}</h2>
        <p class="section-body">{{ section.settings.founder_bio | default: "Replace this with your real story. Where you grew up, how you started skating, when you made your first ring, what this means to you. People buy from people — especially when the thing is made by hand." }}</p>
        <p class="section-body" style="margin-top:1rem;">{{ section.settings.founder_bio_2 | default: "Add a second paragraph here — your background, your workshop, what skateboarding means to this brand." }}</p>
        {%- if section.settings.founder_signature != blank -%}
          <p class="about-founder-sig">{{ section.settings.founder_signature }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
/* ── About Hero ────────────────────────────────────────── */
.about-hero {
  position: relative;
  background-size: cover;
  background-position: center top;
  min-height: 80vh;
  display: flex;
  align-items: center;
  text-align: center;
  padding: 10rem 2rem 7rem;
  overflow: hidden;
}
.about-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8,16,32,0.6) 0%, rgba(8,16,32,0.78) 100%);
}
.about-hero .container { position: relative; z-index: 1; }
.about-hero h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(4.5rem, 10vw, 9rem);
  font-weight: 400;
  color: var(--cream);
  letter-spacing: 0.04em;
  line-height: 0.9;
  margin: 0.75rem 0 1.5rem;
}
.about-hero-sub {
  font-size: 1.1rem;
  color: rgba(240,231,211,0.75);
  max-width: 44ch;
  margin: 0 auto;
  line-height: 1.8;
  font-weight: 300;
}

/* ── Statement ─────────────────────────────────────────── */
.about-statement {
  background: var(--navy);
  padding: 7rem 2rem;
}
.about-statement-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(3rem, 7vw, 6.5rem);
  color: var(--cream);
  line-height: 0.92;
  letter-spacing: 0.04em;
  max-width: 14ch;
  margin: 0;
}
.about-statement-rule {
  width: 48px;
  height: 2px;
  background: var(--gold);
  margin: 2.5rem 0;
}
.about-statement-sub {
  font-family: 'Barlow', sans-serif;
  font-size: 1.05rem;
  color: rgba(240,231,211,0.6);
  max-width: 50ch;
  line-height: 1.82;
  margin: 0;
}

/* ── Origin ────────────────────────────────────────────── */
.about-origin { background: var(--cream-light); padding-bottom: 0; }
.about-origin-image-block {
  background: var(--cream-light);
  width: 100%;
}
.about-origin-image-block img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  display: block;
}
.about-origin-heading {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(1.3rem, 2.2vw, 1.8rem);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--navy);
  line-height: 1.2;
  margin-bottom: 1.25rem;
}
.about-origin-photo-main img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  display: block;
  border-radius: 2px;
}
.about-origin .section-body {
  font-size: 1.05rem;
  line-height: 1.82;
  color: #1a1a1a;
}

/* ── Built for Riders ──────────────────────────────────── */
.about-riders { background: var(--cream); }
.about-riders-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
.about-riders-img img {
  width: 75%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center top;
  display: block;
  margin: 0 auto;
}
.about-riders-heading {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2rem, 4vw, 3.5rem);
  color: var(--navy);
  letter-spacing: 0.04em;
  line-height: 0.95;
  margin: 0.5rem 0 1.25rem;
}
.about-riders .section-body {
  font-size: 1rem;
  line-height: 1.82;
  color: #1a1a1a;
}

/* ── Values ────────────────────────────────────────────── */
.about-values { background: var(--cream-light); }
.about-values-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.about-values-heading {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  letter-spacing: 0.04em;
  color: var(--navy);
  line-height: 0.95;
}
.about-values-list { display: flex; flex-direction: column; }
.about-value-item {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 2.5rem;
  align-items: start;
  padding: 2.5rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.about-value-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2.8rem;
  color: rgba(0,0,0,0.07);
  line-height: 1;
  letter-spacing: 0.04em;
  padding-top: 0.15rem;
  flex-shrink: 0;
}
.about-value-content h3 {
  font-family: 'Oswald', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--navy);
  margin-bottom: 0.6rem;
}
.about-value-content p {
  font-size: 1rem;
  line-height: 1.82;
  color: #1a1a1a;
}

/* ── Full-bleed photo ──────────────────────────────────── */
.about-fullbleed {
  position: relative;
  height: 60vh;
  min-height: 400px;
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  display: flex;
  align-items: flex-end;
}
.about-fullbleed-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.2) 55%, transparent 100%);
}
.about-fullbleed-text {
  position: relative;
  z-index: 1;
  padding: 3rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}
.about-fullbleed-eyebrow {
  font-family: 'Oswald', sans-serif;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--gold);
  display: block;
  margin-bottom: 0.75rem;
}
.about-fullbleed-statement {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2rem, 5vw, 4rem);
  color: var(--cream);
  letter-spacing: 0.04em;
  line-height: 0.95;
  max-width: 700px;
  margin: 0;
}

/* ── Founder ───────────────────────────────────────────── */
.about-founder { background: var(--cream-light); }
.about-founder-grid {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 5rem;
  align-items: center;
}
.about-founder-img { position: relative; }
.about-founder-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.5rem, 4vw, 4rem);
  letter-spacing: 0.04em;
  color: var(--navy);
  line-height: 0.95;
  margin: 0.5rem 0 1.25rem;
}
.about-founder-photos-stack { position: relative; }
.about-founder-photos-stack .about-founder-photo {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center top;
  display: block;
  border-radius: 2px;
}
.about-founder-inset {
  position: absolute;
  bottom: -1.5rem;
  right: -1.5rem;
  width: 52%;
  border: 3px solid var(--cream-light);
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.2);
}
.about-founder-inset img {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  display: block;
}
.about-founder-photo {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  object-position: center top;
  display: block;
  border-radius: 2px;
}
.about-founder-img { position: relative; }
.about-founder .section-body {
  font-size: 1.05rem;
  line-height: 1.82;
  color: #1a1a1a;
}
.about-founder-sig {
  font-family: 'Josefin Slab', serif;
  font-size: 1.6rem;
  font-style: italic;
  color: var(--navy);
  margin-top: 1.5rem;
  opacity: 0.75;
}

/* ── Process teaser ────────────────────────────────────── */
.about-process-teaser { background: var(--cream); border-top: 1px solid rgba(0,0,0,0.07); }
.about-process-heading {
  font-family: 'Oswald', sans-serif;
  font-size: clamp(1.2rem, 2vw, 1.6rem);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--navy);
  line-height: 1.2;
}
.about-process-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 3rem;
  flex-wrap: wrap;
}
.about-process-teaser .section-body {
  font-size: 1rem;
  line-height: 1.75;
  color: var(--muted);
}

/* ── Responsive ────────────────────────────────────────── */
@media (max-width: 860px) {
  .about-riders-grid { grid-template-columns: 1fr; gap: 3rem; }
  .about-riders-img { max-width: 480px; }
  .about-founder-grid { grid-template-columns: 1fr; gap: 3rem; }
  .about-founder-img { max-width: 360px; margin: 0 auto; }
  .about-founder-inset { display: none; }
  .about-value-item { grid-template-columns: 52px 1fr; gap: 1.5rem; }
  .about-process-inner { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
}
@media (max-width: 768px) {
  .about-fullbleed { background-attachment: scroll; }
}
@media (max-width: 600px) {
  .about-hero { padding: 7rem 2rem 5rem; min-height: 60vh; }
  .about-statement { padding: 5rem 2rem; }
}
</style>

{% schema %}
{
  "name": "About Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_bg_image", "label": "Hero background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built From Boards" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every ring starts with a skateboard that already lived a life. We just give it another one." },
    { "type": "header", "content": "Statement" },
    { "type": "textarea", "id": "statement_headline", "label": "Statement headline", "default": "Your board carried you.\nNow it carries something else." },
    { "type": "textarea", "id": "statement_body", "label": "Statement body", "default": "Every ring starts as a board that was actually skated — pressed maple, worn rails, real history. We don't use new wood. We don't need to. The material is already out there." },
    { "type": "header", "content": "Origin Story" },
    { "type": "text", "id": "origin_eyebrow", "label": "Eyebrow", "default": "Where It Started" },
    { "type": "text", "id": "origin_heading", "label": "Heading", "default": "A Board, a Saw, and a Good Idea" },
    { "type": "textarea", "id": "origin_body_1", "label": "Paragraph 1", "default": "It started in a garage. A skateboard deck — maple wood dense enough to absorb years of impact — went onto the bandsaw. The cross-section stopped everything. Seven layers of hard maple with teal, red, and raw wood stacked like a tiny landscape. A ring was the obvious next move." },
    { "type": "textarea", "id": "origin_body_2", "label": "Paragraph 2", "default": "Bayshore Rings grew from that one cut. Small operation, made by hand, built on a commitment to reclaimed materials and zero synthetic finishes. The goal was never to make precious jewelry. It was to make something worth keeping — jewelry that outlasts trends and throwaway culture." },
    { "type": "header", "content": "The Material" },
    { "type": "text", "id": "material_eyebrow", "label": "Eyebrow", "default": "The Material" },
    { "type": "text", "id": "material_heading", "label": "Heading", "default": "Why Skateboards" },
    { "type": "textarea", "id": "material_body", "label": "Body", "default": "Skateboarding isn't just a sport — it's a culture built on creativity, grit, and self-expression. Every deck carries that energy: the tricks it absorbed, the concrete it crossed, the skater who shaped it. When we turn that wood into a ring, we're not just making jewelry. We're capturing something real — the soul of skateboarding, worn on your hand every day." },
    { "type": "header", "content": "Built for Riders" },
    { "type": "image_picker", "id": "riders_image", "label": "Riders photo" },
    { "type": "text", "id": "riders_image_alt", "label": "Riders photo alt text", "default": "Skateboarder riding a concrete bowl" },
    { "type": "text", "id": "riders_eyebrow", "label": "Eyebrow", "default": "For the Rider" },
    { "type": "textarea", "id": "riders_heading", "label": "Heading", "default": "These Aren't for People Who Think Skating Is Cool." },
    { "type": "textarea", "id": "riders_body_1", "label": "Paragraph 1", "default": "They're for people who actually do it. Who know what a proper pop sounds like. Who've had the same deck for three years because the concave is perfect. Who understand that a board doesn't die — it just changes shape." },
    { "type": "textarea", "id": "riders_body_2", "label": "Paragraph 2", "default": "We make rings for skaters because we understand the culture — and the responsibility that comes with it. Every ring is built from reclaimed maple and finished with natural beeswax, because jewelry shouldn't cost the planet. Sustainable by design. Made to be worn every day." },
    { "type": "text", "id": "riders_btn_text", "label": "Button text", "default": "Shop the Rings" },
    { "type": "url", "id": "riders_btn_url", "label": "Button link" },
    { "type": "header", "content": "Values Section" },
    { "type": "text", "id": "values_heading", "label": "Heading", "default": "Made Right. No Shortcuts." },
    { "type": "header", "content": "Full-Bleed Image" },
    { "type": "image_picker", "id": "fullbleed_image", "label": "Full-bleed background image" },
    { "type": "text", "id": "fullbleed_image_alt", "label": "Image alt text", "default": "Skateboard on concrete road" },
    { "type": "text", "id": "fullbleed_eyebrow", "label": "Eyebrow label", "default": "Zero Waste" },
    { "type": "textarea", "id": "fullbleed_statement", "label": "Statement text", "default": "No virgin wood.\nNo landfill.\nJust a board that already existed,\nshaped into something that lasts." },
    { "type": "header", "content": "Skate Photo (below Founder)" },
    { "type": "image_picker", "id": "skate_image", "label": "Full-width skate photo" },
    { "type": "text", "id": "skate_image_alt", "label": "Skate photo alt text", "default": "Skateboarder at a concrete skatepark" },
    { "type": "header", "content": "Founder" },
    { "type": "image_picker", "id": "founder_image", "label": "Founder photo" },
    { "type": "text", "id": "founder_eyebrow", "label": "Eyebrow", "default": "The Maker" },
    { "type": "text", "id": "founder_name", "label": "Name", "default": "Clay" },
    { "type": "textarea", "id": "founder_bio", "label": "Bio paragraph 1", "default": "Replace this with your real story." },
    { "type": "textarea", "id": "founder_bio_2", "label": "Bio paragraph 2", "default": "Add a second paragraph here." },
    { "type": "text", "id": "founder_signature", "label": "Signature (optional)" },
    { "type": "header", "content": "Process Teaser" },
    { "type": "text", "id": "process_heading", "label": "Heading", "default": "Want to see the whole process?" },
    { "type": "textarea", "id": "process_body", "label": "Body", "default": "From sourcing the board to the final coat. Four steps, no shortcuts." },
    { "type": "url", "id": "process_link", "label": "Link" },
    { "type": "text", "id": "process_btn", "label": "Button text", "default": "See How We Make Them" },
    { "type": "header", "content": "CTA Banner" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Get Yours" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Wear the Board. Keep the Story." },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "text", "id": "cta_btn", "label": "Button text", "default": "Shop the Collection" },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 800 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Hero height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 100 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Material Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "7" },
        { "type": "text", "id": "label", "label": "Label", "default": "Maple Plies" }
      ]
    },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "No New Materials" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Every ring is made from a board that already existed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page",
      "blocks": [
        { "type": "stat", "settings": { "number": "100%", "label": "Recycled Wood" } },
        { "type": "stat", "settings": { "number": "7", "label": "Maple Plies" } },
        { "type": "stat", "settings": { "number": "1", "label": "Of a Kind" } },
        { "type": "value", "settings": { "title": "No New Materials", "body": "Every ring is made from a board that already existed. We don't source new wood. We reclaim what's already there." } },
        { "type": "value", "settings": { "title": "Small Batch Always", "body": "We don't run production lines. Rings are made in small batches, by hand, with attention to every one." } },
        { "type": "value", "settings": { "title": "Built for Daily Wear", "body": "Skateboard maple is one of the densest hardwoods in everyday production. It handles impact, heat, and daily use. So does the ring." } }
      ]
    }
  ]
}
{% endschema %}
