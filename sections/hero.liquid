{%- assign _min_h = section.settings.section_min_height -%}
{%- assign _align = section.settings.text_align -%}
{%- assign _mw    = section.settings.content_max_width -%}
{%- assign _pos   = section.settings.content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
<section class="hero" id="home" style="padding-top:{{ section.settings.padding_top }}rem; padding-bottom:{{ section.settings.padding_bottom }}rem;{% if _min_h > 0 %}min-height:{{ _min_h }}vh;{% endif %}">
  <div class="hero-text" style="max-width:{{ _mw }}px;margin:{{ _cmarg }};text-align:{{ _align }};">
    <div class="hero-kicker">
      <div class="hero-kicker-line"></div>
      <span>{{ section.settings.kicker }}</span>
    </div>
    <h1 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h1>
    <div class="hero-actions">
      <a href="{{ section.settings.btn_primary_url | default: '/collections/all' }}" class="btn btn-gold btn-hero-primary">{{ section.settings.btn_primary }}</a>
      <a href="{{ section.settings.btn_secondary_url | default: '/pages/our-process' }}" class="btn btn-ghost">{{ section.settings.btn_secondary }}</a>
    </div>
  </div>

  <div class="hero-bg">
    {%- if section.settings.hero_image != blank -%}
      <img class="hero-ring-photo" src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.hero_image_alt | default: 'Bayshore Rings — handcrafted rings from recycled skateboard decks' }}" loading="eager">
    {%- else -%}
      <img class="hero-ring-photo" src="{{ 'about-working.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'Bayshore Rings — handcrafted rings from recycled skateboard decks' }}" loading="eager">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker text", "default": "Bayshore Rings · Small Batch · Coastal Craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handcrafted Rings From Recycled Skateboards" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Bayshore Rings turns retired skateboard decks into clean, durable rings with natural color, character, and history in every piece." },
    { "type": "text", "id": "btn_primary", "label": "Primary button text", "default": "Shop Rings" },
    { "type": "url", "id": "btn_primary_url", "label": "Primary button link" },
    { "type": "text", "id": "btn_secondary", "label": "Secondary button text", "default": "Our Process" },
    { "type": "url", "id": "btn_secondary_url", "label": "Secondary button link" },
    { "type": "header", "content": "Hero Image" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero photo alt text", "default": "Bayshore Rings — handcrafted rings from recycled skateboard decks" },
    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (rem)", "min": 0, "max": 16, "step": 1, "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (rem)", "min": 0, "max": 16, "step": 1, "default": 0 },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "left" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 650 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "left" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Section height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 0 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
