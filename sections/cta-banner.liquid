{%- if section.settings.bg_image != blank -%}
  {%- assign _cta_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- endif -%}
<section class="cta-section" style="padding-top:{{ section.settings.padding_top }}rem; padding-bottom:{{ section.settings.padding_bottom }}rem;{% if section.settings.bg_image != blank %} background-image:url('{{ _cta_bg }}');background-size:cover;background-position:center;position:relative;{% endif %}">
  {%- if section.settings.bg_image != blank and section.settings.bg_overlay > 0 -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.bg_overlay | divided_by: 100.0 }});pointer-events:none;" aria-hidden="true"></div>
  {%- endif -%}
  <div class="cta-content reveal" style="position:relative;">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn-gold" style="font-size:0.85rem; padding:1rem 2.5rem;">
      {{ section.settings.btn_text }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Get Yours"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear the Board. Keep the Story."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "bg_overlay",
      "label": "Overlay darkness (%)",
      "min": 0,
      "max": 80,
      "step": 10,
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (rem)",
      "min": 0,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (rem)",
      "min": 0,
      "max": 16,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}
