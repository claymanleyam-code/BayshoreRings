{%- if section.settings.bg_image != blank -%}
  {%- assign _coast_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- endif -%}
{%- assign _min_h = section.settings.section_min_height -%}
{%- assign _align = section.settings.text_align -%}
{%- assign _mw    = section.settings.content_max_width -%}
{%- assign _pos   = section.settings.content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
<section class="section coastal" id="coastal" style="padding-top:{{ section.settings.padding_top }}rem; padding-bottom:{{ section.settings.padding_bottom }}rem;{% if _min_h > 0 %}min-height:{{ _min_h }}vh;{% endif %}{% if section.settings.bg_image != blank %} background-image:url('{{ _coast_bg }}');background-size:cover;background-position:center;position:relative;{% endif %}">
  {%- if section.settings.bg_image != blank and section.settings.bg_overlay > 0 -%}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.bg_overlay | divided_by: 100.0 }});pointer-events:none;" aria-hidden="true"></div>
  {%- endif -%}
  <div class="container" style="position:relative;">
    <div class="coastal-inner reveal" style="max-width:{{ _mw }}px;margin:{{ _cmarg }};text-align:{{ _align }};">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
      <div class="coastal-rule"></div>
      <p style="font-size:{{ section.settings.body_size }}px;">{{ section.settings.body }}</p>
      <div class="coastal-stats">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <span class="stat-num">{{ block.settings.number }}</span>
            <span class="stat-lbl">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <figure class="coastal-photo-wrap reveal">
    {%- if section.settings.photo_1 != blank -%}
      <img src="{{ section.settings.photo_1 | image_url: width: 1600 }}" alt="{{ section.settings.photo_1_alt | default: 'Skateboarder riding concrete at speed' }}" class="coastal-photo" loading="lazy" width="1024" height="500">
    {%- else -%}
      <img src="https://images.unsplash.com/photo-1547447134-cd3f5c716030?fm=jpg&q=80&w=1600&auto=format&fit=crop" alt="{{ section.settings.photo_1_alt | default: 'Skateboarder riding concrete at speed' }}" class="coastal-photo" loading="lazy" width="1024" height="500">
    {%- endif -%}
  </figure>

  <figure class="coastal-photo-wrap coastal-photo-skate-wrap reveal">
    {%- if section.settings.photo_2 != blank -%}
      <img src="{{ section.settings.photo_2 | image_url: width: 1600 }}" alt="{{ section.settings.photo_2_alt | default: 'Skateboarding culture and community' }}" class="coastal-photo coastal-photo--skate" loading="lazy" width="1024" height="500">
    {%- else -%}
      <img src="https://cdn.shopify.com/s/files/1/0530/0695/8744/t/22/assets/the-role-of-skateboard-clothing-in-skate-culture_550x.jpg" alt="{{ section.settings.photo_2_alt | default: 'Skateboarding culture and community' }}" class="coastal-photo coastal-photo--skate" loading="lazy" width="1024" height="500">
    {%- endif -%}
  </figure>
</section>

{% schema %}
{
  "name": "Coastal Americana",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "The Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewelry for the Culture." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Skate culture doesn't follow trends — it sets them. We make jewelry that's built the same way: from reclaimed materials that waste nothing, worn by people who actually skate. Sustainable by design. Made to last as long as the passion does." },
    { "type": "header", "content": "Section Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Section background image" },
    { "type": "range", "id": "bg_overlay", "label": "Overlay darkness (%)", "min": 0, "max": 80, "step": 10, "default": 0 },
    { "type": "header", "content": "Photos" },
    { "type": "image_picker", "id": "photo_1", "label": "Photo 1" },
    { "type": "text", "id": "photo_1_alt", "label": "Photo 1 alt text", "default": "Skateboarder riding concrete at speed" },
    { "type": "image_picker", "id": "photo_2", "label": "Photo 2" },
    { "type": "text", "id": "photo_2_alt", "label": "Photo 2 alt text", "default": "Skateboarding culture and community" },
    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (rem)", "min": 0, "max": 16, "step": 1, "default": 5 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (rem)", "min": 0, "max": 16, "step": 1, "default": 5 },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "range", "id": "content_max_width", "label": "Content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 500 },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Section height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 0 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "100%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Recycled Wood" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coastal Americana",
      "blocks": [
        { "type": "stat", "settings": { "number": "100%", "label": "Recycled Wood" } },
        { "type": "stat", "settings": { "number": "7", "label": "Maple Plies" } },
        { "type": "stat", "settings": { "number": "1", "label": "Of a Kind" } }
      ]
    }
  ]
}
{% endschema %}
