<!-- ═══════════════════════════════════════════════════
     BAYSHORE RINGS — Our Process Page
     ═══════════════════════════════════════════════════ -->

{%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
{%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_item' -%}

<!-- ── HERO ────────────────────────────────────────────── -->
{%- assign _min_h = section.settings.section_min_height -%}
{%- assign _align = section.settings.text_align -%}
{%- assign _mw    = section.settings.content_max_width -%}
{%- assign _pos   = section.settings.content_position -%}
{%- if _pos == 'left' -%}{%- assign _cmarg = '0 auto 0 0' -%}{%- elsif _pos == 'right' -%}{%- assign _cmarg = '0 0 0 auto' -%}{%- else -%}{%- assign _cmarg = '0 auto' -%}{%- endif -%}
<div
  class="proc-hero"
  style="position:relative;overflow:hidden;{% if _min_h > 0 %}min-height:{{ _min_h }}vh;display:flex;flex-direction:column;justify-content:center;{% endif %}">
  <video id="proc-hero-video" autoplay muted loop playsinline preload="auto" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;">
    <source src="{{ '177797a164b843089275fa9e1a04ebe4.MOV' | asset_url }}" type="video/quicktime">
  </video>
  <script>
    (function(){
      var v = document.getElementById('proc-hero-video');
      if(!v) return;
      v.muted = true;
      v.volume = 0;
      function tryPlay(){ v.muted=true; v.play().catch(function(){}); }
      var retry = setInterval(function(){ if(!v.paused){ clearInterval(retry); } else { tryPlay(); } }, 300);
      setTimeout(function(){ clearInterval(retry); }, 5000);
      v.addEventListener('pause', function(){ if(!v.ended){ tryPlay(); } });
      document.addEventListener('visibilitychange', function(){ if(!document.hidden && v.paused){ tryPlay(); } });
    })();
  </script>
  <div class="proc-hero-overlay" aria-hidden="true" style="position:absolute;inset:0;z-index:1;"></div>
  <div class="container" style="position:relative;z-index:2;text-align:{{ _align }};max-width:{{ _mw }}px;margin:{{ _cmarg }};">
    {%- if section.settings.hero_eyebrow != blank -%}
      <span class="eyebrow reveal d1" style="color:#ffffff;">{{ section.settings.hero_eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.hero_heading != blank -%}
      <h1 class="reveal d2" style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.hero_heading | newline_to_br }}</h1>
    {%- endif -%}
    {%- if section.settings.hero_body != blank -%}
      <p class="proc-hero-sub reveal d3" style="font-size:{{ section.settings.body_size }}px;">{{ section.settings.hero_body }}</p>
    {%- endif -%}
  </div>
</div>

<!-- ── WHERE EVERY BOARD COMES FROM ────────────────────── -->
<section class="section proc-intro">
  <div class="container">
    <div class="proc-intro-grid">
      <div class="reveal d1">
        {%- if section.settings.intro_heading != blank -%}
          <h2 class="proc-intro-heading">{{ section.settings.intro_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro_body != blank -%}
          <div class="section-body">{{ section.settings.intro_body }}</div>
        {%- endif -%}
      </div>
      {%- if stat_blocks.size > 0 -%}
        <div class="proc-community-visual reveal d2">
          <div class="proc-stat-stack">
            {%- for block in stat_blocks -%}
              <div class="proc-stat-item" {{ block.shopify_attributes }}>
                <span class="proc-stat-num">{{ block.settings.number }}</span>
                <span class="proc-stat-label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- ── PROCESS IMAGE GRID ───────────────────────────────── -->
{%- if gallery_blocks.size > 0 -%}
<section class="section proc-gallery">
  <div class="container">
    <div class="proc-gallery-grid">
      {%- for block in gallery_blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign gallery_src = block.settings.image | image_url: width: 1200 -%}
        {%- elsif forloop.index == 1 -%}
          {%- assign gallery_src = 'https://www.skatedeluxe.com/blog/wp-content/uploads/2016/10/Skateboard-Deck-Plys-Close-Up.jpg' -%}
        {%- elsif forloop.index == 2 -%}
          {%- assign gallery_src = 'https://everskate.com/wp-content/uploads/2020/02/skateboard-art-1.jpg' -%}
        {%- elsif forloop.index == 3 -%}
          {%- assign gallery_src = 'https://images.unsplash.com/photo-1763392199096-6efd9d28d8cc?fm=jpg&q=80&w=1200&auto=format&fit=crop' -%}
        {%- else -%}
          {%- assign gallery_src = blank -%}
        {%- endif -%}
        {%- if gallery_src != blank -%}
          <div class="proc-gallery-item{% if forloop.first %} proc-gallery-item--large{% endif %}" {{ block.shopify_attributes }}>
            <img
              src="{{ gallery_src }}"
              alt="{{ block.settings.alt | escape }}"
              class="proc-gallery-img"
              loading="lazy" width="800" height="560">
            {%- if block.settings.label != blank -%}
              <span class="proc-gallery-label">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- ── DONATE CTA ──────────────────────────────────────── -->
<section class="section proc-donate">
  <div class="container">
    <div class="proc-donate-inner reveal">
      <div>
        {%- if section.settings.donate_heading != blank -%}
          <h2 class="proc-donate-heading">{{ section.settings.donate_heading | newline_to_br }}</h2>
        {%- endif -%}
        {%- if section.settings.donate_body != blank -%}
          <p class="section-body">{{ section.settings.donate_body }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.donate_btn_text != blank -%}
        <div class="proc-donate-actions">
          <a href="{{ section.settings.donate_btn_url | default: '/collections/all' }}" class="btn btn-gold">{{ section.settings.donate_btn_text }} &rarr;</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- ── FINAL CTA ───────────────────────────────────────── -->
<section class="cta-section">
  <div class="cta-content reveal">
    {%- if section.settings.final_eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.final_eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.final_heading != blank -%}
      <h2>{{ section.settings.final_heading | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.final_btn_text != blank -%}
      <a href="{{ section.settings.final_btn_url | default: '/collections/all' }}" class="btn btn-gold" style="font-size:0.85rem;padding:1rem 2.5rem;">{{ section.settings.final_btn_text }}</a>
    {%- endif -%}
  </div>
</section>

<style>
/* ── Process hero ──────────────────────────────────────── */
.proc-hero {
  position: relative;
  background-size: cover;
  background-position: center;
  min-height: 70vh;
  display: flex;
  align-items: center;
  text-align: center;
  overflow: hidden;
  padding: 8rem 2rem 6rem;
}
.proc-hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(8,16,32,0.35);
}
.proc-hero .container { position: relative; z-index: 1; }
.proc-hero h1 {
  font-family: 'Moms Typewriter', sans-serif;
  font-size: clamp(3.5rem, 7vw, 7rem);
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 0.04em;
  line-height: 0.95;
  margin: 0.75rem 0 1.5rem;
}
.proc-hero-sub {
  font-size: 1.05rem;
  color: #ffffff;
  max-width: 52ch;
  margin: 0 auto;
  line-height: 1.8;
  font-weight: 300;
}

/* ── Intro section ─────────────────────────────────────── */
.proc-intro { background: var(--cream-light); }
.proc-intro-heading {
  font-family: 'Moms Typewriter', sans-serif;
  font-size: clamp(1.3rem, 2.2vw, 1.8rem);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--navy);
  line-height: 1.2;
  margin-bottom: 1.25rem;
}
.proc-intro .section-body {
  font-size: 1rem;
  line-height: 1.82;
  color: #1a1a1a;
}
.proc-intro .section-body p + p { margin-top: 1rem; }
.proc-intro-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
.proc-community-visual { display: flex; justify-content: center; }
.proc-stat-stack {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 300px;
}
.proc-stat-item {
  padding: 1.4rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
.proc-stat-item:first-child { border-top: 1px solid rgba(0,0,0,0.08); }
.proc-stat-num {
  display: block;
  font-family: 'Moms Typewriter', sans-serif;
  font-size: 3rem;
  color: var(--navy);
  line-height: 1;
  letter-spacing: 0.04em;
  margin-bottom: 0.2rem;
}
.proc-stat-label {
  font-family: 'Shine Typewriter', sans-serif;
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}

/* ── Gallery ───────────────────────────────────────────── */
.proc-gallery { background: #C8A57A; padding-top: 0; }
.proc-gallery-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 1rem;
}
.proc-gallery-item { position: relative; overflow: hidden; }
.proc-gallery-item--large { grid-row: span 2; }
.proc-gallery-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
  min-height: 200px;
}
.proc-gallery-item:hover .proc-gallery-img { transform: scale(1.04); }
.proc-gallery-label {
  position: absolute;
  bottom: 0.75rem;
  left: 0.75rem;
  font-family: 'Moms Typewriter', sans-serif;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(240,231,211,0.9);
  background: rgba(0,0,0,0.45);
  padding: 0.3rem 0.6rem;
  backdrop-filter: blur(4px);
}

/* ── Donate CTA ────────────────────────────────────────── */
.proc-donate { background: var(--cream-light); }
.proc-donate-heading {
  font-family: 'Moms Typewriter', sans-serif;
  font-size: clamp(2.5rem, 4vw, 4rem);
  letter-spacing: 0.04em;
  color: var(--navy);
  line-height: 0.95;
  margin-bottom: 1rem;
}
.proc-donate .section-body {
  font-size: 1rem;
  line-height: 1.75;
  color: var(--muted);
  max-width: 44ch;
}
.proc-donate-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 3rem;
  flex-wrap: wrap;
  padding: 4rem 0;
  border-top: 1px solid rgba(0,0,0,0.07);
  border-bottom: 1px solid rgba(0,0,0,0.07);
}
.proc-donate-actions { display: flex; flex-direction: column; gap: 0.75rem; flex-shrink: 0; }

/* ── Responsive ────────────────────────────────────────── */
@media (max-width: 860px) {
  .proc-intro-grid { grid-template-columns: 1fr; gap: 3rem; }
  .proc-stat-stack { max-width: 100%; flex-direction: row; flex-wrap: wrap; }
  .proc-stat-item { flex: 1; min-width: 130px; }
  .proc-gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .proc-gallery-item--large { grid-row: auto; }
  .proc-donate-inner { flex-direction: column; align-items: flex-start; }
  .proc-donate-actions { flex-direction: row; }
}
@media (max-width: 620px) {
  .proc-gallery-grid { grid-template-columns: 1fr; }
  .proc-donate-actions { flex-direction: column; }
}
</style>

{% schema %}
{
  "name": "Our Process Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Handcrafted" },
    { "type": "textarea", "id": "hero_heading", "label": "Hero heading", "info": "Line breaks in this field become line breaks in the heading.", "default": "From Retired Deck\nto Daily Wear" },
    { "type": "textarea", "id": "hero_body", "label": "Hero subheading", "default": "Built without compromise. Every ring starts with reclaimed maple — a material skaters already trust with their feet. No new lumber. No synthetic finishes. Just something built to last." },
    { "type": "header", "content": "Where the Wood Comes From" },
    { "type": "text", "id": "intro_heading", "label": "Heading", "default": "Where the Wood Comes From" },
    { "type": "richtext", "id": "intro_body", "label": "Body text", "default": "<p>Every ring starts with reclaimed hard maple — the same wood skate decks are built from for a reason. Dense, durable, and naturally beautiful, hard maple is one of the most resilient hardwoods available. We use it exclusively.</p><p>By working with reclaimed wood, we eliminate the need for newly harvested lumber and keep usable material out of the waste stream. Every ring is a direct investment in a more sustainable approach to jewelry that doesn't compromise on quality.</p>" },
    { "type": "header", "content": "Donate CTA" },
    { "type": "textarea", "id": "donate_heading", "label": "Heading", "info": "Line breaks in this field become line breaks in the heading.", "default": "Built to Last.\nNot to Replace." },
    { "type": "textarea", "id": "donate_body", "label": "Body text", "default": "Fast fashion has a cost. We make rings from reclaimed maple and finish them with natural beeswax — no synthetic resins, no coatings that crack or peel. One ring, built right, built to stay on your finger for years." },
    { "type": "text", "id": "donate_btn_text", "label": "Button text", "default": "Shop the Rings" },
    { "type": "url", "id": "donate_btn_url", "label": "Button link" },
    { "type": "header", "content": "Final CTA" },
    { "type": "text", "id": "final_eyebrow", "label": "Eyebrow", "default": "Handcrafted" },
    { "type": "textarea", "id": "final_heading", "label": "Heading", "info": "Line breaks in this field become line breaks in the heading.", "default": "Every Ring Has a Story.\nWhat's Yours?" },
    { "type": "text", "id": "final_btn_text", "label": "Button text", "default": "Shop the Collection" },
    { "type": "url", "id": "final_btn_url", "label": "Button link" },
    { "type": "header", "content": "Text & Layout" },
    { "type": "range", "id": "heading_size", "label": "Hero heading size", "min": 16, "max": 96, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "body_size", "label": "Hero body text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "text_align", "label": "Hero text alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "range", "id": "content_max_width", "label": "Hero content width", "min": 300, "max": 1400, "step": 50, "unit": "px", "default": 900 },
    { "type": "select", "id": "content_position", "label": "Hero content position", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}, {"value": "right", "label": "Right"}], "default": "center" },
    { "type": "header", "content": "Section Size" },
    { "type": "range", "id": "section_min_height", "label": "Hero height", "min": 0, "max": 100, "step": 5, "unit": "vh", "default": 100 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "100%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Reclaimed Wood" }
      ]
    },
    {
      "type": "gallery_item",
      "name": "Gallery Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Bayshore Rings process photo" },
        { "type": "text", "id": "label", "label": "Caption label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Process Page",
      "blocks": [
        { "type": "stat", "settings": { "number": "100%", "label": "Reclaimed Wood" } },
        { "type": "stat", "settings": { "number": "0", "label": "New Wood Used" } },
        { "type": "stat", "settings": { "number": "1 of 1", "label": "Every Ring Is Unique" } },
        { "type": "gallery_item", "settings": { "alt": "Close-up cross-section of a skateboard deck showing seven maple plies", "label": "The Source Material" } },
        { "type": "gallery_item", "settings": { "alt": "Colorful skateboard deck art — the raw character we preserve in every ring", "label": "Ridden Hard" } },
        { "type": "gallery_item", "settings": { "alt": "Close-up of warm maple wood grain — the layered texture of reclaimed skateboard wood", "label": "The Grain" } }
      ]
    }
  ]
}
{% endschema %}
